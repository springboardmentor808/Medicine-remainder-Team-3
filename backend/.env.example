# ===========================================
# PillSync Environment Configuration Template
# Copy this file to .env and configure local values
# ===========================================

# --- Application ---
ENVIRONMENT=development
APP_NAME=PillSync
APP_VERSION=0.1.0
PORT=8000
DEBUG=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- JWT Authentication ---
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-jwt-key-here-generate-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Database (SQLite for local dev, PostgreSQL for production) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=med_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_URL=sqlite+aiosqlite:///./pillsync_dev.db
POSTGRES_URL_SYNC=postgresql://postgres:your_secure_password@localhost:5432/med_db

# --- MongoDB (OCR Document Metadata) ---
MONGO_URL=mongodb://localhost:27017/med_db

# --- Redis (Cache & Session Store) ---
REDIS_URL=redis://localhost:6379/0

# --- AI & Vision Services (Optional / Model Training) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Twilio SMS Notification Service (Optional) ---
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --- SendGrid Email Service (Optional) ---
SENDGRID_API_KEY=your_sendgrid_api_key
