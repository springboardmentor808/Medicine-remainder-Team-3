# ===========================================
# PillSync Environment Configuration
# Copy this file to .env and fill in values
# ===========================================

# --- Application ---
ENVIRONMENT=development
APP_NAME=PillSync
APP_VERSION=0.1.0
PORT=8000
DEBUG=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- JWT Authentication ---
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- PostgreSQL (Primary Database) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=med_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/med_db
POSTGRES_URL_SYNC=postgresql://postgres:postgrespassword@localhost:5432/med_db

# --- MongoDB (Phase 2+: OCR Metadata) ---
MONGO_URL=mongodb://localhost:27017/med_db

# --- Redis (Cache & Sessions) ---
REDIS_URL=redis://localhost:6379/0

# --- AI Services (Phase 3+) ---
OPENAI_API_KEY=sk-proj-your-openai-api-key

# --- Twilio SMS (Phase 4+) ---
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --- SendGrid Email (Phase 4+) ---
SENDGRID_API_KEY=SG.your_sendgrid_api_key
